//using loop to add the elements of an array
920F    // Addr 00: LLI R1, 15      
9414    // Addr 01: LLI R2, 20      
9800    // Addr 02: LLI R4, 0       
9E01    // Addr 03: LLI R7, 1       
C283    // Addr 04: BEQ R1, R2, 3   
AA40    // Addr 05: LW R5, R1, 0    
0960    // Addr 06: ADD R4, R4, R5  
03C8    // Addr 07: ADD R1, R1, R7  
E1FE    // Addr 08: J -2            
0000    // Addr 09: ADD R0, R0, R0   NOP
B819    // Addr 10: SW R4, R0, 25   
E000    // Addr 11: J 0             infinite loop
0000    // Addr 12: 0000             Unused memory
0000    // Addr 13: 0000             Unused memory
0000    // Addr 14: 0000             Unused memory
0005    // Addr 15: 0005             Array[0] = 5
000A    // Addr 16: 000A             Array[1] = 10
000F    // Addr 17: 000F             Array[2] = 15
0014    // Addr 18: 0014             Array[3] = 20
0019    // Addr 19: 0019             Array[4] = 25
